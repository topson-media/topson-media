rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Videos & Video Tutorials: Anyone can read, anyone can create/update/delete (managed by admin)
    match /videos/{videoId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    match /video_tutorials/{tutorialId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Community Feedback & Testimonials: Publicly readable, users can submit and toggle likes (+1 / -1)
    match /feedbacks/{feedbackId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    match /community_feedback/{feedbackId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Live Chat Messages: Private conversation history per user & Admin access
    // Regular users can only access their private thread where user_id matches; Admin accesses all
    match /messages/{messageId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    match /chat_messages/{messageId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Users: Profiles and accounts
    match /users/{userId} {
      allow read, create, update, delete: if true;
    }

    // Pending email verifications for new account creation
    match /pending_verifications/{verificationId} {
      allow read, write: if true;
    }

    // Contact Form Submissions
    match /contact_submissions/{submissionId} {
      allow read, create, update, delete: if true;
    }

    // Support & Mobile Money Donations to 0794903078
    match /support_donations/{donationId} {
      allow read, create, update, delete: if true;
    }

    // Live Streaming Studio & Real-time Viewer Interactions
    match /live_sessions/{sessionId} {
      allow read, create, update, delete: if true;
      
      match /chat/{messageId} {
        allow read, create, update, delete: if true;
      }
    }
  }
}

